# Use as variáveis separadas para não precisar escapar caracteres da senha.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=ruralfin
PGUSER=ruralfin_app
PGPASSWORD=preencha_a_senha_local
# Na hospedagem, DATABASE_URL substitui as variáveis PG acima.
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/ruralfin?sslmode=require
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash
# Opcional: chave no servidor. A chave digitada na interface tem prioridade.
GEMINI_API_KEY=
PORT=5001
APP_USERNAME=admin
# Obrigatório na hospedagem; opcional para acesso local.
APP_PASSWORD=
SECRET_KEY=gere_um_segredo_aleatorio
APP_ENV=development
